{
  "name": "@nanostores/react",
  "version": "2.0.0",
  "description": "React integration for Nano Stores, a tiny state manager with many atomic tree-shakable stores",
  "keywords": [
    "react",
    "react native",
    "state",
    "state manager",
    "store"
  ],
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "nanostores/react",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:lint": "oxlint .",
    "test:coverage": "pnpm bnt --coverage",
    "test:types": "check-dts",
    "test:size": "size-limit",
    "test": "pnpm run /^test:/"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.1.0",
    "@nanostores/async": "^0.1.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "better-node-test": "^1.0.0",
    "check-dts": "^2.0.1",
    "happy-dom": "^20.12.0",
    "nanodelay": "^2.0.2",
    "nanostores": "^1.5.3",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "nanostores": "^1.2.0",
    "react": ">=18.0.0"
  },
  "size-limit": [
    {
      "import": {
        "index.js": "{ useStore }",
        "nanostores": "{ map, computed }"
      },
      "limit": "1204 B",
      "name": "useStore"
    },
    {
      "import": {
        "index.js": "{ useLoadingStore }",
        "nanostores": "{ map, computed }"
      },
      "limit": "1334 B",
      "name": "useLoadingStore"
    }
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  }
}
